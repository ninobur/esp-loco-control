+// Drains both rings to the wire and emits STATUS once a second. Called from
+// networkTask ONLY: the radio, the CRC and the 844-byte stack buffer all live
+// on that task, never on the Hall task.
+static void xhrNetworkDrain(){
+  if (!xhrDestValid || WiFi.status() != WL_CONNECTED) return;
+  // One static buffer, one consumer. Deliberately NOT on the stack: X19 put a
+  // pair of 704-byte buffers on a 4 KB task stack and the overflow was real,
+  // latent and only found by accident.
+  static XhrSampleBatch out;
+  static uint8_t        small[sizeof(XhrHeader) + 64];
+  // Bounded per call so a backlog cannot monopolise networkTask and stall the
+  // MQTT loop: 12 datagrams is 1.2 s of trace, drained every 10 ms, which
+  // empties a full 4 s ring in well under a second.
+  for (int i = 0; i < 12; ++i) {
+    if (!xhrSamples.popBatch(&out)) break;
+    const uint32_t n = xhrSampleBatchWireLen(&out);
+    if (!xhrUdp.beginPacket(xhrDest, XHR_PORT) ||
+        xhrUdp.write((const uint8_t*)&out, n) != n ||
+        !xhrUdp.endPacket()) ++xhrUdpFailures;
+    else ++xhrDatagramsSent;
+  }
+  for (int i = 0; i < 4; ++i) {
+    const uint32_t n = xhrRulings.popSealed(small, sizeof(small));
+    if (!n) break;
+    if (!xhrUdp.beginPacket(xhrDest, XHR_PORT) ||
+        xhrUdp.write(small, n) != n || !xhrUdp.endPacket()) ++xhrUdpFailures;
+    else ++xhrDatagramsSent;
+  }
+  static uint32_t lastStatusMs = 0, lastStatusSamples = 0;
+  const uint32_t now = (uint32_t)millis();
+  if (now - lastStatusMs >= 1000) {
+    const uint32_t dtMs = lastStatusMs ? (now - lastStatusMs) : 1000;
+    const uint32_t cum = xhrSamples.cumSamples();
+    XhrStatusRec st;
+    memset(&st, 0, sizeof(st));
+    st.tMs      = now;
+    st.uptimeMs = now;
+    st.cumSamples          = cum;
+    st.cumSampleRingDrops  = xhrSamples.cumRingDrops();
+    st.cumRulingRingDrops  = xhrRulings.cumRingDrops();
+    st.cumUdpFailures      = xhrUdpFailures;
+    st.maxGapUs            = xhrSamples.maxGapUs();
+    st.maxTickBodyUs       = xhrMaxTickBodyUs;
