+    st.hallStackFreeBytes  = hallTaskHandle ? uxTaskGetStackHighWaterMark(hallTaskHandle) : 0;
+    st.netStackFreeBytes   = uxTaskGetStackHighWaterMark(nullptr);
+    st.measuredHzX10 = (uint16_t)(dtMs ? ((uint64_t)(cum - lastStatusSamples) * 10000ULL / dtMs) : 0);
+    st.ringHighWater = xhrSamples.highWater();
+    st.rssi          = (int8_t)WiFi.RSSI();
+    st.mqttConnected = mqtt.connected() ? 1 : 0;
+    st.wifiConnected = 1;
+    lastStatusMs = now; lastStatusSamples = cum;
+    const uint32_t n = xhrSealStatus(small, sizeof(small), (uint32_t)LOCO_ID,
+                                     xhrSessionId, ++xhrStatusSeq, st,
+                                     xhrMirBaseline, xhrMirNavMm, xhrMirNavDir,
+                                     xhrMirStPhase, xhrMirCtxFlags,
+                                     (uint16_t)(xhrSamples.cumRingDrops() & 0xFFFFu));
+    if (n) {
+      if (!xhrUdp.beginPacket(xhrDest, XHR_PORT) ||
+          xhrUdp.write(small, n) != n || !xhrUdp.endPacket()) ++xhrUdpFailures;
+      else ++xhrDatagramsSent;
+    }
+  }
