+static void publishRvm() {
+  rvm::Token t;
+  while(navi.takeToken(t)) {
+    char row[1000];
+    const int size=snprintf(row,sizeof(row),
+      "{\"boot\":\"%016llX\",\"run\":%lu,\"ordinal\":%lu,\"expected_mm\":%d,\"committed_mm\":%d,"
+      "\"serial_first\":%lu,\"serial_last\":%lu,\"source_first_us\":%llu,\"source_last_us\":%llu,"
+      "\"commit_us\":%llu,\"consume_lag_us\":%llu,\"match_quality\":%.4f,\"progression_evidence\":%.4f,"
+      "\"applied_pwm\":%u,\"ir_integrity\":%u,\"trusted_mm\":%d,\"mismatch_streak\":%u,"
+      "\"model\":%lu,\"phase\":%.1f,\"reason\":\"%s\",\"token_log_drops\":%lu}",
+      (unsigned long long)t.boot,(unsigned long)t.run,(unsigned long)t.ordinal,t.expected,t.committed,
+      (unsigned long)t.firstSerial,(unsigned long)t.lastSerial,(unsigned long long)t.firstUs,
+      (unsigned long long)t.lastUs,(unsigned long long)t.commitUs,(unsigned long long)(t.commitUs-t.lastUs),
+      double(t.quality),double(t.evidence),unsigned(t.pwm),unsigned(t.irValid),t.trusted,unsigned(t.mismatches),
+      (unsigned long)t.model,double(t.phase),t.stopDecision?"LOSS_OF_PROGRESSION_ESTOP":t.mismatches>=5?"LOSS_OF_PATTERN_FIVE_NEW_PIECES":t.finalQuality?(t.atypical?"FINAL_ATYPICAL_NO_REANCHOR":"FINAL_COHERENT"):(t.atypical?"COUNTED_PROVISIONALLY_ATYPICAL":"EXPECTED_PIECE_APPEARED"),
+      (unsigned long)navi.diagnosticDrops());
+    if(size>0 && size<int(sizeof(row))) { pub("diag/rvm_decision",row);console.printf("[RVM] %s\n",row); }
+  }
+}
