# Secrets — never committed. credentials_template.h is the pattern to copy.
credentials.h
firmware/*/credentials.h

# Run captures: evidence, not source. Large and constantly changing.
logs/
*.log

# EXCEPT the curated field record: certification runs and cal recordings are
# committed evidence, named by content date and locomotive. See
# field-records/README.md.
!field-records/logs/
!field-records/logs/*.log
!field-records/logs/navlab-inputs/
!field-records/logs/navlab-inputs/*.log

# Arduino build artefacts
build/
*.elf
*.bin
*.hex

# macOS
.DS_Store
.AppleDouble
Icon?

# Python
__pycache__/
*.pyc
.venv/
venv/
firmware/libraries
firmware/libraries
firmware/test-programs/ESPNOW_CMD_TX/espnow_keys.h

# host-test build output
firmware/test-programs/*/tests/gen/
