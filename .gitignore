# Secrets — never committed. credentials_template.h is the pattern to copy.
credentials.h
firmware/*/credentials.h

# Run captures: evidence, not source. Large and constantly changing.
logs/
*.log

# EXCEPT the curated field record: certification runs and cal recordings are
# committed evidence, named by content date and locomotive. See
# field-records/README.md.
!field-records/logs/
!field-records/logs/*.log

# Oversized curated captures are retained locally under their original names
# and committed losslessly as Git-LFS-managed .log.gz archives. Exact ignores
# prevent an ordinary `git add` from staging GitHub-rejected raw blobs.
field-records/logs/20260813_otto_1_13_noquorum_watch.log
field-records/logs/20260820_morning_session.log

# Arduino build artefacts
build/
*.elf
*.bin
*.hex

# macOS
.DS_Store
.AppleDouble
Icon?

# Python
__pycache__/
*.pyc
.venv/
venv/
firmware/libraries
firmware/libraries
firmware/test-programs/ESPNOW_CMD_TX/espnow_keys.h

# Host regression harness build products (regenerated by run_tests.sh)
firmware/test-programs/TEMPLATES/tests/gen/
