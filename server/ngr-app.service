Description=NGR Flask dashboard
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=david
WorkingDirectory=/home/david
ExecStart=/usr/bin/python3 /home/david/ngr_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
